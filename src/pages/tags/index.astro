---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugify } from '../../utils';

const posts = await getCollection('blog');
const tags = [...new Set(posts.flatMap((post) => post.data.tags))]
	.map((tag) => ({ tag, count: posts.filter((post) => post.data.tags.includes(tag)).length }))
	.sort((a, b) => a.tag.localeCompare(b.tag));
---

<BaseLayout title='Topics — Muhamad Risman' description='Browse software engineering topics explored by Muhamad Risman.'>
	<div class='site-container page-shell'>
		<header class='page-header'>
			<div>
				<p class='eyebrow'>Topics / Index</p>
				<h1 class='page-title'>An index of<br /><em>curiosity.</em></h1>
			</div>
			<p>Browse the themes that recur in my notes—from engineering fundamentals to the practical details of building for the web.</p>
		</header>

		<div class='topic-index'>
			{
				tags.map(({ tag, count }, index) => (
					<a href={`/tags/${slugify(tag)}/`}>
						<span class='topic-number'>0{index + 1}</span>
						<strong>{tag}</strong>
						<span>
							{count} {count === 1 ? 'note' : 'notes'}
						</span>
						<span aria-hidden='true'>↗</span>
					</a>
				))
			}
		</div>
	</div>
</BaseLayout>

<style>
	.page-title em {
		font-weight: inherit;
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 0.15em;
	}

	.topic-index {
		border-top: 1px solid var(--line);
	}

	.topic-index a {
		display: grid;
		grid-template-columns: 4rem 1fr auto 2rem;
		gap: 1rem;
		align-items: center;
		padding: 1.35rem 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		transition:
			padding 180ms ease,
			background 180ms ease;
	}

	.topic-index a:hover {
		padding-inline: 1rem;
		background: color-mix(in srgb, var(--accent) 17%, transparent);
	}

	.topic-number,
	.topic-index a > span:nth-child(3) {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		text-transform: uppercase;
	}

	.topic-index strong {
		font-family: var(--font-display);
		font-size: clamp(1.7rem, 3vw, 2.7rem);
		font-weight: 400;
	}

	@media (max-width: 560px) {
		.topic-index a {
			grid-template-columns: 2rem 1fr 1.5rem;
		}

		.topic-index a > span:nth-child(3) {
			display: none;
		}
	}
</style>
