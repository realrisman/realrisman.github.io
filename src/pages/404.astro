---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title='404 — Page Not Found' description='This page does not exist.'>
	<section class='not-found site-container'>
		<div class='error-code' aria-hidden='true'>404</div>
		<div class='error-copy'>
			<p class='eyebrow'>Wrong turn / Dead end</p>
			<h1>This route leads<br />nowhere. <em>Yet.</em></h1>
			<p>The page may have moved, or perhaps it never existed. Either way, there are better places to continue.</p>
			<div class='error-actions'>
				<a class='button-primary' href='/'>Back to home</a>
				<a class='button-secondary' href='/posts/'>Browse writing</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.not-found {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: clamp(2rem, 7vw, 7rem);
		align-items: center;
		min-height: calc(100svh - 4.75rem);
		padding-block: 4rem;
	}

	.error-code {
		font-family: var(--font-display);
		font-size: clamp(10rem, 30vw, 26rem);
		letter-spacing: -0.09em;
		line-height: 0.7;
		text-decoration: line-through;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 0.08em;
	}

	.error-copy h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.4rem, 6vw, 6rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 0.92;
	}

	.error-copy h1 em {
		font-weight: inherit;
	}

	.error-copy > p:not(.eyebrow) {
		max-width: 31rem;
		margin: 2rem 0 0;
		color: var(--muted);
		line-height: 1.7;
	}

	.error-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2rem;
	}

	@media (max-width: 760px) {
		.not-found {
			grid-template-columns: 1fr;
		}

		.error-code {
			font-size: 44vw;
		}
	}
</style>
