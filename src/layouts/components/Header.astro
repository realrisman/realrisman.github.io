---
const menu = [
	{ link: '/about/', label: 'About' },
	{ link: '/projects/', label: 'Work' },
	{ link: '/posts/', label: 'Writing' },
	{ link: '/tags/', label: 'Topics' }
];

const section = `/${Astro.url.pathname.split('/').filter(Boolean)[0] || ''}/`;
---

<header class='site-header'>
	<div class='site-container header-inner'>
		<a class='brand' href='/' aria-label='Muhamad Risman, home'>
			<span class='brand-mark'>MR</span>
			<span class='brand-name'>Muhamad Risman</span>
		</a>

		<nav class='desktop-nav' aria-label='Primary navigation'>
			{
				menu.map((item) => (
					<a href={item.link} aria-current={section === item.link ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class='header-actions'>
			<a class='desktop-contact' href='mailto:real.risman@gmail.com'>Let's talk <span aria-hidden='true'>↗</span></a>
			<button class='theme-toggle' type='button' aria-label='Switch color theme' title='Switch color theme'>
				<svg
					class='sun-icon'
					aria-hidden='true'
					viewBox='0 0 24 24'
					width='18'
					height='18'
					fill='none'
					stroke='currentColor'
					stroke-width='1.8'
					><circle cx='12' cy='12' r='4'></circle><path
						d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41'
					></path></svg
				>
				<svg
					class='moon-icon'
					aria-hidden='true'
					viewBox='0 0 24 24'
					width='18'
					height='18'
					fill='none'
					stroke='currentColor'
					stroke-width='1.8'><path d='M21 12.8A8.5 8.5 0 1 1 11.2 3 6.6 6.6 0 0 0 21 12.8Z'></path></svg
				>
			</button>

			<details class='mobile-nav'>
				<summary aria-label='Open navigation'>Menu</summary>
				<nav aria-label='Mobile navigation'>
					{
						menu.map((item, index) => (
							<a href={item.link} aria-current={section === item.link ? 'page' : undefined}>
								<span>0{index + 1}</span>
								{item.label}
							</a>
						))
					}
					<a href='mailto:real.risman@gmail.com'><span>05</span>Contact</a>
				</nav>
			</details>
		</div>
	</div>
</header>

<script>
	import { syncGiscusTheme as syncGiscusFrameTheme } from '../../giscusTheme';

	const syncThemeButton = () => {
		const isDark = document.documentElement.classList.contains('dark');
		document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
			button.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
		});
	};

	const syncGiscusTheme = () => {
		const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
		if (!iframe) return false;

		syncGiscusFrameTheme(iframe, () => document.documentElement.classList.contains('dark'));
		return true;
	};

	const syncGiscusThemeWhenReady = () => {
		if (syncGiscusTheme()) return;

		const script = document.querySelector<HTMLScriptElement>('script[src="https://giscus.app/client.js"]');
		script?.addEventListener('load', syncGiscusTheme, { once: true });
	};

	document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
		button.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
			syncThemeButton();
			syncGiscusTheme();
		});
	});

	syncThemeButton();
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', syncGiscusThemeWhenReady, { once: true });
	} else {
		syncGiscusThemeWhenReady();
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--background) 86%, transparent);
		border-bottom: 1px solid var(--line);
		backdrop-filter: blur(16px);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 4.75rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		font-weight: 700;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 2.45rem;
		height: 2.45rem;
		place-items: center;
		background: var(--text);
		color: var(--background);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: -0.06em;
	}

	.brand-name {
		font-size: 0.92rem;
	}

	.desktop-nav {
		display: flex;
		gap: 2rem;
	}

	.desktop-nav a,
	.desktop-contact {
		position: relative;
		color: var(--muted);
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
	}

	.desktop-nav a:hover,
	.desktop-nav a[aria-current='page'] {
		color: var(--text);
	}

	.desktop-nav a[aria-current='page']::after {
		content: '';
		position: absolute;
		right: 0;
		bottom: -0.5rem;
		left: 0;
		height: 2px;
		background: var(--accent);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.desktop-contact {
		padding-right: 0.75rem;
		color: var(--text);
	}

	.theme-toggle {
		display: grid;
		width: 2.45rem;
		height: 2.45rem;
		place-items: center;
		background: transparent;
		border: 1px solid var(--line);
		color: var(--text);
		cursor: pointer;
	}

	.theme-toggle:hover {
		background: var(--accent);
		color: var(--accent-ink);
	}

	.moon-icon,
	:global(.dark) .sun-icon {
		display: none;
	}

	:global(.dark) .moon-icon {
		display: block;
	}

	.mobile-nav {
		display: none;
	}

	@media (max-width: 760px) {
		.header-inner {
			min-height: 4.25rem;
		}

		.brand-name,
		.desktop-nav,
		.desktop-contact {
			display: none;
		}

		.mobile-nav {
			display: block;
		}

		.mobile-nav summary {
			padding: 0.65rem 0.8rem;
			border: 1px solid var(--line);
			font-family: var(--font-mono);
			font-size: 0.7rem;
			list-style: none;
			text-transform: uppercase;
			cursor: pointer;
		}

		.mobile-nav summary::-webkit-details-marker {
			display: none;
		}

		.mobile-nav nav {
			position: fixed;
			top: 4.25rem;
			right: 0;
			left: 0;
			display: grid;
			padding: 1.5rem 1rem 2rem;
			background: var(--background);
			border-bottom: 1px solid var(--line);
			box-shadow: var(--shadow);
		}

		.mobile-nav nav a {
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 1rem 0;
			border-bottom: 1px solid var(--line);
			font-family: var(--font-display);
			font-size: 2rem;
			text-decoration: none;
		}

		.mobile-nav nav a span {
			color: var(--muted);
			font-family: var(--font-mono);
			font-size: 0.65rem;
		}
	}
</style>
