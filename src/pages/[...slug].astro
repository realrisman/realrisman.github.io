---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import Prose from '../components/Prose.astro';
import TableOfContent from '../components/widgets/TableOfContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { slugify } from '../utils';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}

type Props = CollectionEntry<'blog'>;
const post = Astro.props;
const { Content, headings } = await render(post);
const { title, seoTitle, description, pubDate, updatedDate, coverImage, tags } = post.data;
---

<BaseLayout title={`${seoTitle || title} — Muhamad Risman`} description={description}>
	<article class='article-page site-container page-shell'>
		<header class='article-header'>
			<div class='article-kicker'>
				<a href='/posts/'>Writing</a>
				<span>/</span>
				<FormattedDate date={pubDate} />
			</div>
			<h1>{title}</h1>
			<p>{description}</p>
			<div class='article-meta'>
				<div><span>Written by</span><strong>Muhamad Risman</strong></div>
				{
					updatedDate && (
						<div>
							<>
								<span>Last updated</span>
								<strong>
									<FormattedDate date={updatedDate} />
								</strong>
							</>
						</div>
					)
				}
				<div class='article-tags'>
					{
						tags.map((tag) => (
							<a class='tag' href={`/tags/${slugify(tag)}/`}>
								{tag}
							</a>
						))
					}
				</div>
			</div>
		</header>

		{coverImage && <Image class='cover-image' src={coverImage} alt='' width={1200} height={630} />}

		<div class='article-layout'>
			<aside class='article-aside'>
				{headings.length > 0 && <TableOfContent headings={headings} />}
				<div class='share-links'>
					<p>Share</p>
					<a
						href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
						target='_blank'
						rel='noopener noreferrer'>LinkedIn ↗</a
					>
					<a href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(Astro.url.href)}`}>Email ↗</a>
				</div>
			</aside>

			<div class='article-main'>
				<Prose><Content /></Prose>

				<div class='author-card'>
					<img src='/profile-zoomed.webp' alt='' width='160' height='160' />
					<div>
						<span>About the author</span><h2>Muhamad Risman</h2><p>
							Senior software engineer focused on dependable products, scalable systems, and clear technical decisions.
						</p>
					</div>
					<a class='text-link' href='/about/'>More about me →</a>
				</div>

				{
					import.meta.env.GISCUS_REPO && import.meta.env.GISCUS_REPO_ID && (
						<section class='comments'>
							<h2>Continue the conversation</h2>
							<script
								is:inline
								src='https://giscus.app/client.js'
								data-repo={import.meta.env.GISCUS_REPO}
								data-repo-id={import.meta.env.GISCUS_REPO_ID}
								data-category={import.meta.env.GISCUS_CATEGORY}
								data-category-id={import.meta.env.GISCUS_CATEGORY_ID}
								data-mapping='pathname'
								data-reactions-enabled='1'
								data-input-position='top'
								data-theme='preferred_color_scheme'
								data-lang='en'
								data-loading='lazy'
								crossorigin='anonymous'
								async
							/>
						</section>
					)
				}
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.article-header {
		max-width: 65rem;
		margin: 0 auto clamp(3rem, 6vw, 5rem);
		text-align: center;
	}

	.article-kicker {
		display: flex;
		justify-content: center;
		gap: 0.7rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.article-kicker a {
		text-decoration: none;
	}

	.article-header h1 {
		margin: 2rem 0;
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 8vw, 7.5rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 0.92;
	}

	.article-header > p {
		max-width: 42rem;
		margin: 0 auto;
		color: var(--muted);
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.article-meta {
		display: flex;
		justify-content: center;
		gap: 2rem;
		align-items: center;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}

	.article-meta > div:not(.article-tags) {
		display: grid;
		gap: 0.25rem;
		text-align: left;
	}

	.article-meta span {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.55rem;
		text-transform: uppercase;
	}

	.article-meta strong {
		font-size: 0.78rem;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.cover-image {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 4rem;
		border: 1px solid var(--line);
	}

	.article-layout {
		display: grid;
		grid-template-columns: 15rem minmax(0, 46rem);
		gap: clamp(2rem, 6vw, 6rem);
		justify-content: center;
		align-items: start;
	}

	.article-aside {
		position: sticky;
		top: 7rem;
	}

	.share-links {
		display: grid;
		gap: 0.6rem;
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
		font-size: 0.75rem;
	}

	.share-links p {
		margin: 0 0 0.35rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.58rem;
		text-transform: uppercase;
	}

	.share-links a {
		text-decoration: none;
	}

	.author-card {
		display: grid;
		grid-template-columns: 5rem 1fr auto;
		gap: 1.25rem;
		align-items: center;
		margin-top: 4rem;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
	}

	.author-card img {
		width: 5rem;
		height: 5rem;
		object-fit: cover;
		border-radius: 50%;
	}

	.author-card span {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.55rem;
		text-transform: uppercase;
	}

	.author-card h2 {
		margin: 0.25rem 0;
		font-family: var(--font-display);
		font-size: 1.8rem;
		font-weight: 400;
	}

	.author-card p {
		margin: 0;
		color: var(--muted);
		font-size: 0.78rem;
		line-height: 1.5;
	}

	.comments {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}

	.comments h2 {
		font-family: var(--font-display);
		font-size: 2.5rem;
		font-weight: 400;
	}

	@media (max-width: 850px) {
		.article-layout {
			grid-template-columns: 1fr;
		}

		.article-aside {
			position: static;
		}

		.article-meta {
			align-items: flex-start;
			flex-wrap: wrap;
		}
	}

	@media (max-width: 600px) {
		.article-meta {
			justify-content: flex-start;
		}

		.author-card {
			grid-template-columns: 4rem 1fr;
		}

		.author-card img {
			width: 4rem;
			height: 4rem;
		}

		.author-card > a {
			grid-column: 2;
			justify-self: start;
		}
	}
</style>
