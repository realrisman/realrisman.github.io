---
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostItem from '../components/PostItem.astro';
import ProjectList from '../components/ProjectList.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<BaseLayout title={`${SITE_TITLE} — ${SITE_TAGLINE}`} description={SITE_DESCRIPTION}>
	<section class='hero site-container'>
		<div class='hero-copy'>
			<p class='eyebrow'>Senior software engineer · Indonesia</p>
			<h1 class='display-title'>Building software that stays <em>useful.</em></h1>
			<p class='hero-intro'>
				I’m Muhamad Risman, a product-minded engineer with 10+ years of experience turning complex systems into reliable, maintainable
				products.
			</p>
			<div class='hero-actions'>
				<a class='button-primary' href='/projects/'>Explore selected work <span aria-hidden='true'>↗</span></a>
				<a class='button-secondary' href='mailto:real.risman@gmail.com'>Start a conversation</a>
			</div>
		</div>

		<div class='portrait-wrap'>
			<div class='portrait-label'>
				<span>01 / PROFILE</span>
				<span>Available for select projects</span>
			</div>
			<img src='/profile.webp' alt='Muhamad Risman standing in a modern concrete interior' width='1536' height='2048' loading='eager' />
			<div class='portrait-stamp' aria-hidden='true'>10+<small>YEARS</small></div>
		</div>

		<div class='hero-meta' aria-label='Professional highlights'>
			<div><strong>10+</strong><span>Years shipping<br />production software</span></div>
			<div><strong>03</strong><span>Continents of<br />team collaboration</span></div>
			<div><strong>∞</strong><span>Curiosity for<br />hard problems</span></div>
		</div>
	</section>

	<section class='section-block'>
		<div class='site-container'>
			<div class='section-heading-row'>
				<div>
					<p class='eyebrow'>How I contribute</p>
					<h2 class='section-title'>From product idea<br />to dependable system.</h2>
				</div>
				<p>I work across the stack, but the real job is connecting technology, people, and business context into one coherent product.</p>
			</div>

			<div class='expertise-grid'>
				<article>
					<span>01</span>
					<h3>Product engineering</h3>
					<p>Thoughtful web experiences built with React, TypeScript, Next.js, and a close eye on performance.</p>
					<ul><li>Frontend architecture</li><li>Design systems</li><li>Performance</li></ul>
				</article>
				<article>
					<span>02</span>
					<h3>Backend systems</h3>
					<p>Robust services in Go and PHP, designed for clean boundaries, observability, and sustainable scale.</p>
					<ul><li>APIs & microservices</li><li>Event-driven systems</li><li>Cloud infrastructure</li></ul>
				</article>
				<article>
					<span>03</span>
					<h3>Technical leadership</h3>
					<p>Clear decisions, pragmatic standards, and calm collaboration from early discovery through delivery.</p>
					<ul><li>System design</li><li>Team enablement</li><li>Delivery strategy</li></ul>
				</article>
			</div>
		</div>
	</section>

	<section class='section-block site-container'>
		<div class='section-heading-row'>
			<div>
				<p class='eyebrow'>Selected work</p>
				<h2 class='section-title'>Proof over promises.</h2>
			</div>
			<a class='text-link' href='/projects/'>View all work <span aria-hidden='true'>→</span></a>
		</div>
		<ProjectList projects={projects.slice(0, 1)} />
	</section>

	<section class='section-block site-container'>
		<div class='section-heading-row'>
			<div>
				<p class='eyebrow'>Notes from the workbench</p>
				<h2 class='section-title'>Ideas worth<br />writing down.</h2>
			</div>
			<a class='text-link' href='/posts/'>Browse the archive <span aria-hidden='true'>→</span></a>
		</div>
		<div class='post-grid'>
			{posts.map((post) => <PostItem post={post} />)}
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.72fr);
		grid-template-rows: auto auto;
		gap: 2rem clamp(2rem, 6vw, 6rem);
		align-items: end;
		min-height: calc(100svh - 4.75rem);
		padding-block: clamp(3.5rem, 7vw, 6rem) 2rem;
	}

	.hero-copy {
		padding-bottom: clamp(1rem, 4vw, 4rem);
	}

	.display-title em {
		position: relative;
		font-weight: inherit;
		white-space: nowrap;
	}

	.display-title em::after {
		content: '';
		position: absolute;
		right: -0.04em;
		bottom: 0.06em;
		left: -0.02em;
		z-index: -1;
		height: 0.2em;
		background: var(--accent);
		transform: rotate(-1deg);
	}

	.hero-intro {
		max-width: 39rem;
		margin: clamp(2rem, 4vw, 3.5rem) 0 0;
		color: var(--muted);
		font-size: clamp(1.05rem, 1.6vw, 1.3rem);
		line-height: 1.65;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2rem;
	}

	.portrait-wrap {
		position: relative;
		align-self: stretch;
		min-height: 34rem;
		background: var(--surface);
		border: 1px solid var(--line);
		overflow: hidden;
	}

	.portrait-wrap::after {
		content: '';
		position: absolute;
		inset: 0;
		box-shadow: inset 0 0 0 1px color-mix(in srgb, white 12%, transparent);
		pointer-events: none;
	}

	.portrait-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
		filter: saturate(0.72) contrast(1.04);
	}

	.portrait-label {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		z-index: 2;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.8rem 1rem;
		background: rgba(16, 17, 15, 0.78);
		color: #f4f1e7;
		font-family: var(--font-mono);
		font-size: 0.58rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		backdrop-filter: blur(8px);
	}

	.portrait-stamp {
		position: absolute;
		right: -1px;
		bottom: -1px;
		display: grid;
		width: 7rem;
		height: 7rem;
		place-content: center;
		background: var(--accent);
		color: var(--accent-ink);
		font-family: var(--font-display);
		font-size: 2.8rem;
		line-height: 0.75;
		text-align: center;
	}

	.portrait-stamp small {
		margin-top: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.48rem;
		letter-spacing: 0.14em;
	}

	.hero-meta {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.hero-meta > div {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.25rem clamp(0.5rem, 2vw, 1.5rem);
	}

	.hero-meta > div + div {
		border-left: 1px solid var(--line);
	}

	.hero-meta strong {
		font-family: var(--font-display);
		font-size: 2.5rem;
		font-weight: 400;
		line-height: 1;
	}

	.hero-meta span {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.expertise-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
	}

	.expertise-grid article {
		min-height: 25rem;
		padding: 1.5rem;
		background: var(--surface);
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.expertise-grid article > span {
		font-family: var(--font-mono);
		font-size: 0.65rem;
	}

	.expertise-grid h3 {
		max-width: 8ch;
		margin: 5rem 0 1.25rem;
		font-family: var(--font-display);
		font-size: 2.35rem;
		font-weight: 400;
		line-height: 0.95;
	}

	.expertise-grid p {
		color: var(--muted);
		line-height: 1.65;
	}

	.expertise-grid ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}

	.expertise-grid li {
		padding: 0.35rem 0.55rem;
		background: color-mix(in srgb, var(--accent) 18%, transparent);
		font-family: var(--font-mono);
		font-size: 0.58rem;
		text-transform: uppercase;
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--line);
		border: 1px solid var(--line);
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr 0.7fr;
		}

		.expertise-grid,
		.post-grid {
			grid-template-columns: 1fr;
		}

		.expertise-grid article {
			min-height: auto;
		}

		.expertise-grid h3 {
			margin-top: 3rem;
		}
	}

	@media (max-width: 680px) {
		.hero {
			display: flex;
			flex-direction: column;
			min-height: auto;
		}

		.hero-copy {
			padding-bottom: 1rem;
		}

		.portrait-wrap {
			width: 100%;
			min-height: 31rem;
		}

		.hero-meta {
			width: 100%;
		}

		.hero-meta > div {
			display: block;
		}

		.hero-meta strong,
		.hero-meta span {
			display: block;
		}

		.hero-meta span {
			margin-top: 0.5rem;
		}
	}
</style>
