---
import { getCollection } from 'astro:content';
import PostsByYear from '../../components/PostsByYear.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
	title='Writing — Muhamad Risman'
	description='Notes on software architecture, product engineering, and the craft of building dependable systems.'>
	<div class='site-container page-shell'>
		<header class='page-header'>
			<div>
				<p class='eyebrow'>Writing / Field notes</p>
				<h1 class='page-title'>Thinking in<br /><em>public.</em></h1>
			</div>
			<p>Practical notes about clean code, product engineering, system design, and lessons that become clearer once written down.</p>
		</header>
		<PostsByYear posts={posts} />
	</div>
</BaseLayout>

<style>
	.page-title em {
		color: color-mix(in srgb, var(--text) 38%, var(--accent-dark));
		font-weight: inherit;
	}
</style>
