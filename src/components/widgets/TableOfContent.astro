---
const { headings } = Astro.props;
const visibleHeadings = headings.filter((heading: { depth: number }) => heading.depth === 2 || heading.depth === 3);
---

<nav class='toc' aria-label='Table of contents'>
	<p>On this page</p>
	<ol>
		{
			visibleHeadings.map((heading: { depth: number; slug: string; text: string }, index: number) => (
				<li class:list={{ nested: heading.depth === 3 }}>
					<a href={`#${heading.slug}`}>
						<span>{String(index + 1).padStart(2, '0')}</span>
						{heading.text}
					</a>
				</li>
			))
		}
	</ol>
</nav>

<style>
	.toc > p {
		margin: 0 0 1rem;
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.toc ol {
		display: grid;
		gap: 0;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
		list-style: none;
	}

	.toc li {
		border-bottom: 1px solid var(--line);
	}

	.toc li.nested a {
		padding-left: 1rem;
	}

	.toc a {
		display: grid;
		grid-template-columns: 1.8rem 1fr;
		gap: 0.5rem;
		padding: 0.8rem 0;
		color: var(--muted);
		font-size: 0.78rem;
		line-height: 1.35;
		text-decoration: none;
	}

	.toc a:hover {
		color: var(--text);
	}

	.toc a span {
		font-family: var(--font-mono);
		font-size: 0.55rem;
	}
</style>
