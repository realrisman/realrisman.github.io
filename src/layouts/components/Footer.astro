---
const year = new Date().getFullYear();
---

<footer class='site-footer'>
	<div class='site-container footer-main'>
		<div>
			<p class='eyebrow'>Have a complex idea?</p>
			<h2>Let's make it feel <em>simple.</em></h2>
		</div>
		<a class='footer-email' href='mailto:real.risman@gmail.com'>
			real.risman@gmail.com
			<span aria-hidden='true'>↗</span>
		</a>
	</div>
	<div class='site-container footer-meta'>
		<p>© {year} Muhamad Risman</p>
		<nav aria-label='Social links'>
			<a href='https://github.com/realrisman' target='_blank' rel='noopener noreferrer'>GitHub ↗</a>
			<a href='https://www.linkedin.com/in/muhamad-risman/' target='_blank' rel='noopener noreferrer'>LinkedIn ↗</a>
			<a href='/rss.xml'>RSS</a>
		</nav>
		<p>Built with care in Indonesia</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: clamp(3rem, 7vw, 7rem);
		background: var(--text);
		color: var(--background);
	}

	.footer-main {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 2rem;
		align-items: end;
		padding-block: clamp(4rem, 9vw, 8rem);
	}

	.footer-main .eyebrow {
		color: color-mix(in srgb, var(--background) 68%, transparent);
	}

	.footer-main h2 {
		max-width: 11ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 7vw, 6.5rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 0.9;
	}

	.footer-main h2 em {
		color: var(--accent);
		font-weight: inherit;
	}

	.footer-email {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid color-mix(in srgb, var(--background) 45%, transparent);
		font-size: clamp(1rem, 2vw, 1.3rem);
		text-decoration: none;
	}

	.footer-email:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.footer-meta {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 2rem;
		align-items: center;
		padding-block: 1.5rem;
		border-top: 1px solid color-mix(in srgb, var(--background) 22%, transparent);
		color: color-mix(in srgb, var(--background) 64%, transparent);
		font-family: var(--font-mono);
		font-size: 0.65rem;
		text-transform: uppercase;
	}

	.footer-meta p {
		margin: 0;
	}

	.footer-meta p:last-child {
		text-align: right;
	}

	.footer-meta nav {
		display: flex;
		gap: 1.5rem;
	}

	.footer-meta a {
		text-decoration: none;
	}

	.footer-meta a:hover {
		color: var(--accent);
	}

	@media (max-width: 760px) {
		.footer-main,
		.footer-meta {
			grid-template-columns: 1fr;
		}

		.footer-email {
			margin-top: 2rem;
		}

		.footer-meta p:last-child {
			text-align: left;
		}
	}
</style>
