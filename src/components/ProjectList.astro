---
import type { Project } from '../data/projects';

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<div class='project-list'>
	{projects.length === 0 && <p class='empty-state'>More selected work is being documented.</p>}
	{
		projects.map((project, index) => (
			<article class='project-card panel'>
				<div class='project-index'>0{index + 1}</div>
				<div class='project-copy'>
					<p class='project-type'>Selected contribution</p>
					<h3>{project.name}</h3>
					<p class='project-description'>{project.description}</p>
					<div class='project-tags'>
						{project.tags?.map((tag) => (
							<span class='tag'>{tag}</span>
						))}
					</div>
				</div>
				<div class='project-details'>
					{project.contributions && (
						<>
							<p>Contribution highlights</p>
							<ul>
								{project.contributions.slice(0, 4).map((contribution) => (
									<li>{contribution}</li>
								))}
							</ul>
						</>
					)}
					<div class='project-actions'>
						<a class='button-primary' href={project.demoLink} target='_blank' rel={project.demoLinkRel || 'noopener noreferrer'}>
							View project <span aria-hidden='true'>↗</span>
						</a>
						{project.pullRequests && (
							<a class='text-link' href={project.pullRequests} target='_blank' rel='noopener noreferrer'>
								Review contributions
							</a>
						)}
					</div>
				</div>
			</article>
		))
	}
</div>

<style>
	.project-list {
		display: grid;
		gap: 1.25rem;
	}

	.project-card {
		display: grid;
		grid-template-columns: 4rem minmax(0, 1.15fr) minmax(260px, 0.85fr);
		transition:
			transform 180ms ease,
			box-shadow 180ms ease;
	}

	.project-card:hover {
		transform: translateY(-4px);
	}

	.project-index {
		padding: 1.5rem 1rem;
		border-right: 1px solid var(--line);
		font-family: var(--font-mono);
		font-size: 0.65rem;
		text-align: center;
	}

	.project-copy,
	.project-details {
		padding: clamp(1.5rem, 4vw, 3.25rem);
	}

	.project-details {
		background: color-mix(in srgb, var(--background) 62%, var(--surface));
		border-left: 1px solid var(--line);
	}

	.project-type,
	.project-details > p {
		margin: 0 0 1.25rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.project-copy h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3rem, 5vw, 5rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 0.9;
	}

	.project-description {
		max-width: 42rem;
		margin: 1.75rem 0 0;
		color: var(--muted);
		line-height: 1.7;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 2rem;
	}

	.project-details ul {
		display: grid;
		gap: 0.8rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-details li {
		position: relative;
		padding-left: 1.1rem;
		color: var(--muted);
		font-size: 0.87rem;
		line-height: 1.5;
	}

	.project-details li::before {
		content: '↳';
		position: absolute;
		left: 0;
		color: var(--text);
	}

	.project-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		align-items: center;
		margin-top: 2.5rem;
	}

	.empty-state {
		padding: 3rem;
		background: var(--surface);
		border: 1px solid var(--line);
		color: var(--muted);
	}

	@media (max-width: 850px) {
		.project-card {
			grid-template-columns: 3rem 1fr;
		}

		.project-details {
			grid-column: 2;
			border-top: 1px solid var(--line);
			border-left: 0;
		}
	}

	@media (max-width: 560px) {
		.project-card {
			display: block;
		}

		.project-index {
			text-align: left;
			border-right: 0;
			border-bottom: 1px solid var(--line);
		}
	}
</style>
